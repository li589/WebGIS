{
  "version": 1,
  "intents": [
    {
      "name": "set_layer_visibility",
      "description": "Show or hide a map layer by catalog_id.",
      "args": {
        "type": "object",
        "required": ["catalog_id", "visible"],
        "properties": {
          "catalog_id": { "type": "string" },
          "visible": { "type": "boolean" }
        }
      }
    },
    {
      "name": "set_layer_opacity",
      "description": "Set layer opacity (0..1) by catalog_id.",
      "args": {
        "type": "object",
        "required": ["catalog_id", "opacity"],
        "properties": {
          "catalog_id": { "type": "string" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    {
      "name": "fit_layer",
      "description": "Fit map viewport to a layer extent.",
      "args": {
        "type": "object",
        "properties": {
          "catalog_id": { "type": "string" },
          "instance_id": { "type": "string" }
        },
        "anyOf": [{ "required": ["catalog_id"] }, { "required": ["instance_id"] }]
      }
    },
    {
      "name": "list_active_layers",
      "description": "List currently active map layers from the client. Prefer answering the user in Chinese with the layer names; this tool confirms the client-side list.",
      "args": { "type": "object", "properties": {} }
    }
  ]
}
