{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      /* marked-katex-extension 的 package.json `types` 指向其 **源码** src/index.ts，
       * 会把第三方 .ts 纳入 program 并被本项目的 noUnusedParameters 判错（TS6133）。
       * 故用类型垫片接管该包的类型解析（详见 src/types/shims/marked-katex-extension.d.ts）。
       * paths 仅作用于 TS；Vite 用 resolve.alias，打包解析不受影响。 */
      "marked-katex-extension": ["src/types/shims/marked-katex-extension.d.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* 2026-08-22：对齐根 tsconfig（vue-tsc --noEmit 一直按无 noImplicitAny
     * 检查）——代码存量 124 处无注解 lambda 靠 tsbuildinfo 增量缓存侥幸
     * 通过 vue-tsc -b；清缓存后全量报错致 build 阻断。显式关闭与项目
     * 实际代码风格一致的隐式 any 检查（其余 strict 项保持）。 */
    "noImplicitAny": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.d.ts"]
}
