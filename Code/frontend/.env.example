# ============================================================
# CGDA 前端配置示例
# ============================================================

# 后端 API 地址（FastAPI 服务）
# 开发环境：
VITE_API_BASE_URL=http://127.0.0.1:8000
# 生产环境（需要 Vite proxy，见 vite.config.ts）：
# VITE_API_BASE_URL=http://your-domain.com

# 隐藏 Vite 开发红屏叠加层（1/true/on），避免把源码片段打到屏幕上
# 机构演示或临时排障可开；日常本地开发建议保持关闭以便立刻看到错误
# VITE_HIDE_ERROR_OVERLAY=1
