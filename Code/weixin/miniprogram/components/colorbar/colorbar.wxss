/* 顶部 colorbar：windy.app 移动端贴顶横条样式
   - 贴顶全宽，半透明深色底（不挡视野）
   - 薄色带 8px + 标题左 + 单位右
   - 刻度行紧贴色带下方
*/

.cbar {
  background: rgba(14, 22, 33, 0.78);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 6px 14px 5px;
  padding-top: calc(6px + env(safe-area-inset-top));
  box-sizing: border-box;
  color: #ffffff;
}

.cbar-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
}
.cbar-title {
  font-size: 12px;
  font-weight: 500;
  color: #f5f6f7;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 70%;
}
.cbar-unit {
  font-size: 10px;
  color: #a8b2bf;
}

.cbar-strip-bg {
  margin-top: 5px;
  height: 8px;
  border-radius: 2px;
  overflow: hidden;
  display: flex;
  flex-direction: row;
  box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.1);
}
.cbar-strip {
  flex: 1;
  height: 8px;
}
.cbar-swatch {
  flex: 1;
  height: 8px;
}

.cbar-ticks {
  position: relative;
  height: 12px;
  margin-top: 2px;
}
.cbar-tick {
  position: absolute;
  top: 0;
  font-size: 9px;
  color: #a8b2bf;
  transform: translateX(-50%);
  font-family: -apple-system, "Helvetica Neue", monospace;
}
.cbar-tick.t0 {
  left: 0%;
  transform: none;
}
.cbar-tick.tlast {
  left: 100%;
  transform: translateX(-100%);
}
