<view class="shell">
  <!-- 底图：腾讯原生 map（街道 / 影像），禁旋转与倾斜，保证 mercator 对齐成立 -->
  <map
    id="cgdaMap"
    class="map"
    latitude="{{center.latitude}}"
    longitude="{{center.longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    enable-satellite="{{satellite}}"
    enable-rotate="{{false}}"
    enable-overlooking="{{false}}"
    enable-skew="{{false}}"
    enable-3D="{{false}}"
    enable-zoom="{{true}}"
    enable-scroll="{{true}}"
    show-compass="{{false}}"
    show-scale="{{false}}"
    bindregionchange="onRegionChange"
    bindupdated="onMapUpdated"
    bindtap="onMapTap"
  ></map>

  <!-- 数据图层叠加画布：同层渲染，pointer-events:none 透传手势到底图 -->
  <canvas type="2d" id="overlayCanvas" class="overlay-canvas" disable-scroll="{{true}}"></canvas>

  <!-- 顶部自动 colorbar（palette/vmin/vmax/unit 来自 overlay-bounds） -->
  <colorbar
    class="colorbar-slot"
    visible="{{colorbar.visible}}"
    title="{{colorbar.title}}"
    unit="{{colorbar.unit}}"
    palette-id="{{colorbar.paletteId}}"
    vmin="{{colorbar.vmin}}"
    vmax="{{colorbar.vmax}}"
  />

  <!-- 左上角 logo（无文字） -->
  <logo-badge class="logo-slot" />

  <!-- 左上角竖向地图操作工具栏：放大/缩小/指南针/定位（logo-badge 正下方） -->
  <left-tool-bar
    class="ltb-slot"
    bind:zoomin="onZoomIn"
    bind:zoomout="onZoomOut"
    bind:resetnorth="onResetNorth"
    bind:locate="onLocate"
  />

  <!-- 右侧竖向图层大类导航栏：点击图标 → 紧贴左侧弹出图层面板 -->
  <right-tool-bar
    class="rail-slot"
    categories="{{railCategories}}"
    active-layer-id="{{activeLayer.id}}"
    bind:select="onToolBarSelect"
  />

  <!-- 左下角比例尺：紧贴时间轴顶部（+12px 呼吸） -->
  <scale-bar
    class="scale-slot"
    style="bottom: calc({{tlHeight}}px + 12px);"
    meters-per-pixel="{{metersPerPixel}}"
  />

  <!-- 右下角：底图切换（街道 ⇄ 影像），与比例尺同高 -->
  <view
    class="basemap-toggle"
    style="bottom: calc({{tlHeight}}px + 12px);"
    bindtap="toggleSatellite"
    hover-class="btn-hover"
  >
    <text>{{satellite ? '街道' : '影像'}}</text>
  </view>

  <!-- 底部全宽时间轴（hour / day / month / static 由图层时间能力驱动） -->
  <timeline
    class="timeline-slot"
    mode="{{timeline.mode}}"
    ticks="{{timeline.ticks}}"
    current="{{timeline.current}}"
    bind:change="onTimelineChange"
    bind:toggle="onTimelineToggle"
    bind:collapse="onTimelineCollapse"
  />

  <!-- 状态 HUD（图层/瓦片进度）：贴比例尺上方（+41px 间距，对应比例尺盒高矮 4px 的补偿） -->
  <view
    class="debug-hud"
    style="bottom: calc({{tlHeight}}px + 53px);"
    wx:if="{{debugHud}}"
  >
    <text>{{debugHud}}</text>
  </view>

  <!-- 错误横幅 -->
  <view class="banner" wx:if="{{banner}}" bindtap="onBannerTap">
    <text>{{banner}}</text>
  </view>
</view>
