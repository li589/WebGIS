.shell {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #0e1621;
}

.map {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 叠加层：覆盖底图但不拦截手势（同层渲染下 CSS 生效） */
.overlay-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 5;
  pointer-events: none;
}

/* ---- 顶部 colorbar：贴顶全宽横条 ---- */
.colorbar-slot {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

/* ---- logo：避开 colorbar（colorbar 高约 44px） ---- */
.logo-slot {
  position: absolute;
  top: calc(52px + env(safe-area-inset-top));
  left: 12px;
  z-index: 10;
}

/* ---- 左上角工具栏：logo-badge 正下方（logo 高约 44px + 8px 缝隙） ---- */
.ltb-slot {
  position: absolute;
  top: calc(104px + env(safe-area-inset-top));
  left: 12px;
  z-index: 10;
}

/* ---- 右侧工具栏：贴右上角（避开小程序右上胶囊按钮）
 * 胶囊按钮位置：top = safe-area-inset-top，高度约 32px
 * 工具栏从 safe-area-inset-top + 92px 开始（约 40px 缝隙）
 * 右侧留 14px 距离，不贴边 */
.rail-slot {
  position: absolute;
  right: 14px;
  top: calc(env(safe-area-inset-top) + 92px);
  z-index: 10;
}

/* ---- 左下比例尺：bottom 由 WXML 动态绑定（跟随时间轴高度） ---- */
.scale-slot {
  position: absolute;
  left: 12px;
  z-index: 10;
}

/* ---- 底图切换按钮：bottom 由 WXML 动态绑定；圆角/内边距与比例尺/HUD容器对齐 ---- */
.basemap-toggle {
  position: absolute;
  right: 12px;
  z-index: 10;
  min-width: 58px;
  padding: 7px 13px;           /* 内边距与 scale-bar-wrap 同一量级 */
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 10px;          /* 与 HUD/比例尺容器一致，不再是胶囊 */
  box-shadow: 0 4px 16px rgba(14, 22, 33, 0.10),
              inset 0 0 0 0.5px rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #3a3f4a;
  font-weight: 500;
  box-sizing: border-box;
}
.btn-hover {
  background: rgba(24, 95, 165, 0.08);
  opacity: 0.85;
}

/* ---- 底部时间轴 ---- */
.timeline-slot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

/* ---- 状态 HUD：尺寸/圆角/内边距与比例尺容器完全对齐 ---- */
.debug-hud {
  position: absolute;
  left: 12px;
  z-index: 20;
  max-width: 68vw;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 10px;          /* 与 scale-bar-wrap 一致 */
  box-shadow: 0 4px 16px rgba(14, 22, 33, 0.10),
              inset 0 0 0 0.5px rgba(255, 255, 255, 0.5);
  padding: 7px 11px;           /* 与 scale-bar-wrap 一致 */
}
.debug-hud text {
  font-size: 12px;             /* 原 10px → 大一号 */
  color: #3a3f4a;
  font-family: monospace;
  white-space: pre-wrap;
  line-height: 1.55;           /* 行高同步放大 */
}

/* ---- 错误横幅：避开 colorbar 贴顶 ---- */
.banner {
  position: absolute;
  top: calc(56px + env(safe-area-inset-top));
  left: 12px;
  right: 12px;
  z-index: 40;
  background: rgba(226, 75, 74, 0.92);
  border-radius: 8px;
  padding: 8px 12px;
}
.banner text {
  font-size: 11px;
  color: #ffffff;
}
