# ============================================================
# 安全（发布就绪 P0-1 新增，务必先读）
# ------------------------------------------------------------
# BACKEND_ENV：运行环境。代码默认 "production"（fail-secure）。
#   - production / 任何非 development 值：所有 /config/* 写接口与 POST /import/raster
#     强制要求 X-API-Key；未配置 BACKEND_API_KEY 时写请求返回 503（fail-closed）。
#   - development：仅在 BACKEND_API_KEYS_ENABLED=false 且未配置任何 key 时，
#     才允许本地免鉴权旁路（仅用于本机开发，勿用于生产）。
# 本地联调：在 Code/backend/.env 设 BACKEND_ENV=development。
# 生产部署：设 BACKEND_ENV=production 且必须配置 BACKEND_API_KEY。
BACKEND_ENV=production
# 写接口鉴权密钥（生产必填）。生成：python -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_KEY=
# 是否启用 API Key 校验。默认：配置了 BACKEND_API_KEY 即为 true。
# 生产请保持默认（不要显式设为 false）。
# BACKEND_API_KEYS_ENABLED=
# CORS 允许来源（逗号分隔）。默认仅 localhost 白名单；生产按实际前端域名收窄，切勿用 *。
# BACKEND_CORS_ORIGINS=https://your-frontend.example.com
# 写限流是否信任反代转发头（X-Forwarded-For / X-Real-IP）。默认 false。
# 仅在受信 Nginx/gateway 同域入口后设 true；直连 FastAPI 时切勿开启（防伪造绕过限流）。
# BACKEND_TRUST_PROXY=false
# ============================================================

# ---- GEE Engine ----
BACKEND_GEE_ENABLED=true
# 32-byte hex key for encrypting stored GEE credentials (generate with: python -c "import secrets; print(secrets.token_hex(32))")
BACKEND_GEE_CREDENTIALS_ENCRYPTION_KEY=
BACKEND_GEE_CREDENTIALS_DB_PATH=
BACKEND_GEE_STORAGE_BACKEND=local
BACKEND_GEE_LOCAL_STORAGE_ROOT=
# MinIO (only if BACKEND_GEE_STORAGE_BACKEND=minio)
BACKEND_GEE_MINIO_ENDPOINT=
BACKEND_GEE_MINIO_ACCESS_KEY=
BACKEND_GEE_MINIO_SECRET_KEY=
BACKEND_GEE_MINIO_BUCKET=gee-exports
BACKEND_GEE_MINIO_SECURE=false
# Account management
BACKEND_GEE_API_ACCOUNT_MANAGEMENT_ENABLED=true
BACKEND_GEE_ACCOUNT_COOLDOWN_SECONDS=300
# Parallel limits
BACKEND_GEE_MAX_PARALLEL_EXPORTS=2
BACKEND_GEE_MAX_PARALLEL_UPLOADS=4
BACKEND_GEE_MAX_PARALLEL_DOWNLOADS=4

# ---- Weather Engine ----
BACKEND_WEATHER_WORKFLOW_ENABLED=true
# Active-run capacity pools (business vs weather_tile workflows)
BACKEND_MAX_ACTIVE_RUNS=8
BACKEND_MAX_ACTIVE_WEATHER_TILE_RUNS=16
# Per-task inner process pool (algorithms._parallel). Avoid CPU oversubscribe when
# multiple Celery solo workers run heavy inversions concurrently.
# CGDA_MAX_PARALLEL_WORKERS=3
# Soft share of physical cores across estimated concurrent heavy tasks (default 4).
# Set to 1 for single-task / test mode (no sibling headroom).
# CGDA_ESTIMATED_SIBLING_TASKS=4
# Optional commercial weather providers (also configurable in Settings → Weather Providers).
# Providers register disabled by default until an API key is set and the provider is enabled.
# BACKEND_WEATHERAPI_API_KEY=
# BACKEND_OPENWEATHER_API_KEY=
# Self-hosted Open-Meteo API in backend compose (container: cgda-open-meteo).
# Sync jobs live in Code/infra/data-sync (-p data-sync), sharing volume backend_open-meteo-data.
# Start API: docker compose -p backend up -d
# Sync:      cd Code/infra/data-sync && .\sync.ps1   # or ./sync.sh
# Data:      Docker named volume inside Docker Desktop (this PC: I:\Docker\DockerDesktop).
BACKEND_OPEN_METEO_LOCAL_URL=http://127.0.0.1:8080/v1/forecast
BACKEND_OPEN_METEO_SYNC_COMPOSE_PROJECT=data-sync
# BACKEND_OPEN_METEO_SYNC_COMPOSE_DIR=   # default resolves to Code/infra/data-sync
# Self-hosted has no best_match; auto/best_match → this domain (must match open-meteo-sync)
# BACKEND_OPEN_METEO_LOCAL_MODEL=ecmwf_ifs025
# Legacy alias (same as LOCAL_URL for bootstrap):
# BACKEND_OPEN_METEO_URL=http://127.0.0.1:8080/v1/forecast

# ---- Algorithm Data Roots ----
# 地理数据根：本地联调示例（可变；设置页「数据源」可改并写入本文件，需重启后端进程组生效）。
# production 未设 BACKEND_DATA_ROOT 将拒启。勿在代码中静默回退盘符。
BACKEND_DATA_ROOT=I:\Geograph_DataSet
BACKEND_OUTPUT_ROOT=I:\Geograph_DataSet\ProjectOutput
BACKEND_PROJECTBACKUP_ROOT=
# 前端「重启后端」（FastAPI+Worker+Beat）。未设时：development=true，其它环境=false。
# BACKEND_UI_RESTART_ENABLED=true
# 导入永久层配额（默认 100GiB；软预留默认 1GiB，且不超过配额的 10%）
# BACKEND_MAX_IMPORTS_TOTAL_BYTES=107374182400
# BACKEND_IMPORTS_SOFT_RESERVE_BYTES=1073741824

# ---- Runtime cache/temporary paths ----
# 下列 I:/Geograph_DataSet/... 仅为**本实验室联调示例**，他机构/生产必须改成
# 本机实际数据盘。
# 另：launch.py 仍使用 Code/backend/.data/ 存放日志与 PID（与 BACKEND_RUNTIME_ROOT 双轨）。
# BACKEND_RUNTIME_ROOT=I:/Geograph_DataSet/_runtime
# BACKEND_CACHE_DIR=I:/Geograph_DataSet/_runtime/cache
# BACKEND_WORKFLOW_STATE_DIR=I:/Geograph_DataSet/_runtime/workflow_state
# BACKEND_LOG_DIR=I:/Geograph_DataSet/_runtime/logs
# BACKEND_RESULT_ARTIFACT_DIR=I:/Geograph_DataSet/_runtime/artifacts
# BACKEND_PYTHON_PROVIDER_WORKSPACE=I:/Geograph_DataSet/_runtime/python_provider
# BACKEND_GEE_LOCAL_STORAGE_ROOT=I:/Geograph_DataSet/_runtime/gee
# BACKEND_GEE_CREDENTIALS_DB_PATH=I:/Geograph_DataSet/_runtime/workflow_state/gee_credentials.sqlite3
# SSH（默认空用户名=未配置；勿提交实验室个人账号）
# BACKEND_SSH_HPC_USER=
# BACKEND_SSH_WIN11_USER=
# MinIO：生产必须覆盖 compose 默认 minioadmin/minioadmin（见 docker-compose.yml）
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# ---- Map defaults（缺省与天气默认点同源；机构可覆盖首屏中心/缩放/底图）----
# BACKEND_MAP_DEFAULT_LONGITUDE=113.2644
# BACKEND_MAP_DEFAULT_LATITUDE=23.1291
# BACKEND_MAP_DEFAULT_ZOOM=4.8
# BACKEND_MAP_DEFAULT_TILE_SOURCE=gaode-street
# 可选机构 AOI 预设（JSON 数组），前端 Bbox 控件会追加展示：
# BACKEND_MAP_AOI_PRESETS=[{"label":"校园","west":113.3,"south":23.0,"east":113.5,"north":23.2}]

# Static materialize cache (remote/http download nodes)
# Default: {python_provider_workspace}/data_access/materialized
# BACKEND_STATIC_CACHE_ROOT=
# TTL seconds; 0 = never expire (research-group static data policy)
BACKEND_STATIC_CACHE_TTL_SECONDS=0

# ---- Remote storage (NAS SMB/SFTP) ----
# Same encryption key as GEE credentials (required outside development)
# BACKEND_GEE_CREDENTIALS_ENCRYPTION_KEY=
# Optional: short-timeout connectivity probe during layer readiness
BACKEND_REMOTE_READINESS_PROBE=false
# Max single-file download size in bytes (default 512MiB; raise for large HDF/GeoTIFF)
BACKEND_REMOTE_MAX_BYTES=536870912
# Open portal tokens (optional; settings UI DB overlay preferred)
# BACKEND_EARTHDATA_TOKEN=
# BACKEND_NSIDC_TOKEN=
# BACKEND_COPERNICUS_TOKEN=
# Prepend remote URIs to layer default_data_access_sources (JSON, one line).
# Settings UI DB overlay overrides this env when both are set.
# Example（路径请换成机构 DATA_ROOT；下列 I: 仅实验室示例）:
# BACKEND_REMOTE_LAYER_DATA_URIS={"smap-sm-ts":{"SMAP_SPL3SMP_E":["I:/Geograph_DataSet/Soil_Moisture/SMAP"]},"ndvi":{"NDVI_16DAY_RASTER":["I:/Geograph_DataSet/Ecological_Vegetation/NDVI/VIIRS_9km_tif"]},"omega-avg-daily":{"ndvi_folder":["I:/Geograph_DataSet/Ecological_Vegetation/NDVI/daily"],"smap_folder":["I:/Geograph_DataSet/Soil_Moisture/SMAP_Origin_Data"],"ndvi_clim_folder":["I:/Geograph_DataSet/Ecological_Vegetation/NDVI/climatology"],"anc_root":["I:/Geograph_DataSet/Soil_Moisture/SMAP_Auxiliary_Data"],"omega_block_dir":["I:/Geograph_DataSet/Inversion_Results/omega_block"]}}
BACKEND_REMOTE_LAYER_DATA_URIS=
# History retention (encrypted previous secrets)
BACKEND_API_KEY_HISTORY_LIMIT=20
BACKEND_REMOTE_STORAGE_HISTORY_LIMIT=20

# ---- SpatiaLite (mod_spatialite) ----
# 总开关。默认 true：扩展不可用时自动降级（state/metadata DB 不受影响）。
BACKEND_SPATIALITE_ENABLED=true
# 扩展文件路径覆盖（可选；空=自动探测）。
# Windows: 默认探测 Env/Python312/Extras/spatialite/mod_spatialite.dll，其次 %OSGEO4W_ROOT%\bin\mod_spatialite.dll
# Linux:   默认探测 /usr/lib/x86_64-linux-gnu/mod_spatialite.so (apt: libsqlite3-mod-spatialite)
# BACKEND_SPATIALITE_PATH=
# 空间叠加层数据库路径（独立 SQLite 文件；删除即回滚）。空=默认 Code/backend/.data/spatial.sqlite
BACKEND_SPATIALITE_DB_PATH=
