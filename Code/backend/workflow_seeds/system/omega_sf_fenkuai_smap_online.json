{
  "_meta": {
    "kind": "system",
    "engine": "python_provider",
    "name": "SF 块反演在线全流程（SMAP 单温度）",
    "description": "目的：在线拉取 SMAP L3（NSIDC CMR+云 CDN，earthdata 凭证）→ smap_daily 转 YYYYMMDD.mat 落盘规范目录 → omega_sf_fenkuai 8-day 分块 SF 倒推 → DDCA SM/VOD 反演。前置：earthdata 凭证；辅助库/NDVI 气候态本地就绪。产出：SM/VOD/OMEGA 三图层。配置：tb_source=SMAP, freq_ghz=1.4, sf_mode=INVERTED_DAILY。",
    "author": "system",
    "readonly": true,
    "is_template": true,
    "linked_layer_id": "method-smap-omega-doy-dynamic",
    "tags": [
      "pipeline",
      "sf_inversion",
      "online"
    ],
    "category": "inversion"
  },
  "workflow_id": "omega_sf_fenkuai_smap_online",
  "name": "SF 块反演在线全流程（SMAP 单温度）",
  "description": "nsidc_smap_download（earthdata）→ smap_daily（h5→mat）→ omega_sf_fenkuai → SM/VOD/OMEGA 三图层。",
  "nodes": [
    {
      "id": 1,
      "type": "download/nsidc_smap_download",
      "pos": [
        80,
        140
      ],
      "properties": {
        "start_date": "{YYYYMMDD}",
        "end_date": "{YYYYMMDD}",
        "version": "6",
        "dry_run": false
      }
    },
    {
      "id": 2,
      "type": "module/smap_daily",
      "pos": [
        380,
        140
      ],
      "properties": {
        "output_dir": "{DATA_ROOT_WIN}\\Soil_Moisture\\SMAP_Origin_Data"
      }
    },
    {
      "id": 3,
      "type": "data/source",
      "pos": [
        80,
        340
      ],
      "properties": {
        "path": "Soil_Moisture/SMAP_Origin_Data",
        "dataset_key": "smap_folder",
        "notes": "逐日 SMAP .mat（smap_daily 落盘同目录，跨 run 复用）"
      }
    },
    {
      "id": 4,
      "type": "data/source",
      "pos": [
        80,
        500
      ],
      "properties": {
        "path": "Soil_Moisture/SMAP_Auxiliary_Data",
        "dataset_key": "anc_root",
        "notes": "静态辅助库（IGBP_9km_12/Albedo/B/BD/CF/H/SF/VI_v_qa→NDVI_v_max/min）"
      }
    },
    {
      "id": 5,
      "type": "data/source",
      "pos": [
        80,
        660
      ],
      "properties": {
        "path": "Soil_Moisture/SMAP_Auxiliary_Data/NDVI_clim",
        "dataset_key": "ndvi_clim_folder",
        "notes": "NDVI DOY 气候态（SMAP 辅助库 NDVI_clim，与 ndvi_clim_max/min 同源；生态目录 12 月下旬 DOY 全空不可用）"
      }
    },
    {
      "id": 6,
      "type": "module/omega_sf_fenkuai",
      "pos": [
        640,
        400
      ],
      "properties": {
        "module_name": "omega_sf_fenkuai",
        "task_type": "omega_sf_fenkuai",
        "algorithm_params": {
          "tb_source": "SMAP",
          "sm_source": "SMAP",
          "temp_scheme": "ORIG_TS",
          "sf_mode": "INVERTED_DAILY",
          "sf_invert_mode": "POINT1",
          "ndvi_mode": "DOY_CLIM",
          "omega_fixed_mode": "PFT",
          "run_domain": "GLOBAL",
          "block_days": 8,
          "start_date": "20251201",
          "end_date": "20251231",
          "max_pixels": 0,
          "freq_ghz": 1.4,
          "enable_parallel": true,
          "max_workers": 8,
          "pixel_chunk_size": 200000
        }
      }
    },
    {
      "id": 7,
      "type": "data/time_range",
      "pos": [
        80,
        40
      ],
      "properties": {
        "start_at": "2025-12-01T00:00:00",
        "end_at": "2025-12-31T00:00:00",
        "resolution_unit": "day",
        "resolution_step": 1,
        "granularity": "day",
        "bind_timeline": true,
        "timezone": "UTC"
      }
    },
    {
      "id": 8,
      "type": "data/bbox",
      "pos": [
        300,
        40
      ],
      "properties": {
        "west": -180.0,
        "south": -85.0,
        "east": 180.0,
        "north": 85.0,
        "crs": "EPSG:4326"
      }
    },
    {
      "id": 9,
      "type": "output/map_layer",
      "pos": [
        920,
        400
      ],
      "properties": {
        "layer_id": "method-smap-omega-doy-dynamic",
        "display_name": "SF 块反演在线全流程（SMAP 单温度）"
      }
    }
  ],
