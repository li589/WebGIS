  "extra": {
    "purpose": "online_smap_inversion_pipeline",
    "scheme": "SMAP_SINGLE_ORIG_TS_ONLINE_FULL",
    "portal": "nsidc_data",
    "cred_profile": "earthdata",
    "pipeline": "nsidc_smap_download (CMR+云 CDN) → smap_daily (h5→YYYYMMDD.mat) → omega_sf_fenkuai → SM/VOD/OMEGA 三图层",
    "prerequisite": "earthdata 凭证 + 本地辅助库（IGBP_9km_12 等）+ NDVI DOY 气候态",
    "outputs": [
      "SM",
      "VOD",
      "OMEGA"
    ],
    "notes": "模板种子：start_date/end_date 含 YYYYMMDD 占位符，运行前替换。smap_daily 落盘 DATA_ROOT/Soil_Moisture/SMAP_Origin_Data（规范目录），反演经 data/source smap_folder 读取同目录，形成下载→反演跨 run 解耦。"
  }
