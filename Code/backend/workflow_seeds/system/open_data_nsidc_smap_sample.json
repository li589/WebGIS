{
  "_meta": {
    "kind": "system",
    "engine": "common",
    "name": "NSIDC/SMAP 开放数据样例",
    "description": "目的：经 nsidc_smap_download 节点（内部走 CMR 检索 + NSIDC 云 CDN 下载）按日期范围下载 SMAP L3 SPL3SMP_E 土壤湿度 .h5。前置：设置页配置 earthdata 凭证（或节点 username/password）。产出：本地 .h5 目录 + 可选变量提取/格式转换。",
    "author": "system",
    "readonly": true,
    "is_template": true,
    "linked_layer_id": "ref-smap-sm-202512-l3",
    "tags": ["sample", "download"],
    "category": "data_access"
  },
  "workflow_id": "open_data_nsidc_smap_sample",
  "name": "NSIDC/SMAP 开放数据样例",
  "description": "nsidc_smap_download（CMR+云 CDN，earthdata 凭证）→ extract/variable → format_convert(mat)。",
  "nodes": [
    {
      "id": 1,
      "type": "download/nsidc_smap_download",
      "pos": [80, 140],
      "properties": {
        "start_date": "{YYYYMMDD}",
        "end_date": "{YYYYMMDD}",
        "version": "6",
        "dry_run": false
      }
    },
    {
      "id": 2,
      "type": "extract/variable",
      "pos": [640, 140],
      "properties": {
        "variable": "Soil_Moisture_Retrieval_Data_AM/soil_moisture"
      }
    },
    {
      "id": 3,
      "type": "format/convert",
      "pos": [920, 140],
      "properties": {
        "target_format": "mat",
        "variable": "Soil_Moisture_Retrieval_Data_AM/soil_moisture"
      }
    }
  ],
  "links": [
    {"0": 1, "1": 1, "2": 0, "3": 2, "4": 0, "5": "value:string"},
    {"0": 2, "1": 2, "2": 0, "3": 3, "4": 0, "5": "value:string"}
  ],
  "extra": {
    "purpose": "open_portal_sample",
    "portal": "nsidc_data",
    "cred_profile": "earthdata",
    "notes": "nsidc_smap_download 输出为 .h5 目录（granule 非压缩包，无需解压节点）。与本地盘 smap_soil_moisture 系统流互补：本流走开放下载，本地流走 {DATA_ROOT}。max_files 可联调节流。"
  }
}
