{
  "_meta": {
    "kind": "system",
    "engine": "python_provider",
    "name": "SMAP ω 平均反演·双温度（GLDAS 在线）",
    "description": "目的：经 gldas_download 在线拉取 GLDAS NOAH025_3H（.nc4）并由 gldas_nc4_to_mat 转为 DUAL 温度 .mat，再与本地 D1/SMAP/anc/NDVI 一并接入 D2 avg-omega。前置：earthdata 凭证；D1 omega_block 已产出。",
    "author": "system",
    "readonly": true,
    "is_template": true,
    "linked_layer_id": "method-smap-omega-doy-avg",
    "tags": [
      "pipeline",
      "omega_avg",
      "gldas_online"
    ],
    "category": "inversion"
  },
  "workflow_id": "omega_avg_daily_gldas_online",
  "name": "SMAP ω 平均反演·双温度（GLDAS 在线）",
  "description": "gldas_download（GES DISC / earthdata）→ gldas_nc4_to_mat（Ts_gldas/Tsoil*）→ D2 avg-omega DUAL；本地 D1/SMAP/anc/NDVI 数据源并联。语义：平均=ω 固定为多年 DOY 气候态均值，逐日仅做轻量 DDCA 回代。双温度=GLDAS 三温度变量（Ts/Tsoil1/Tsoil2）推土壤 TG 与冠层 TC。",
  "nodes": [
    {
      "id": 1,
      "type": "download/gldas_download",
      "pos": [
        80,
        80
      ],
      "properties": {
        "start_date": "20251227",
        "end_date": "20251231",
        "local_dir": "{DATA_ROOT_WIN}\\Meteorological\\Weather\\GLDAS_Download",
        "version": "2.1",
        "short_name": "GLDAS_NOAH025_3H",
        "dry_run": false,
        "max_files": 8
      }
    },
    {
      "id": 9,
      "type": "download/gldas_nc4_to_mat",
      "pos": [
        320,
        80
      ],
      "properties": {
        "input_dir": "{DATA_ROOT_WIN}\\Meteorological\\Weather\\GLDAS_Download",
        "output_dir": "{DATA_ROOT_WIN}\\Meteorological\\Weather\\GLDAS",
        "ancillary_mat": "{DATA_ROOT_WIN}\\Soil_Moisture\\SMAP_Auxiliary_Data\\IGBP_9km_12.mat",
        "skip_existing": true,
        "dry_run": false,
        "max_files": 8
      }
    },
    {
      "id": 2,
      "type": "data/source",
      "pos": [
        80,
        280
      ],
      "properties": {
        "path": "Inversion_Results/omega_block",
        "dataset_key": "omega_block_output",
        "notes": "D1 omega_block 输出目录"
      }
    },
    {
      "id": 3,
      "type": "data/source",
      "pos": [
        80,
        440
      ],
      "properties": {
        "path": "Soil_Moisture/SMAP_Origin_Data",
        "dataset_key": "smap_daily_mat",
        "notes": "逐日 SMAP .mat"
      }
    },
    {
      "id": 4,
      "type": "data/source",
      "pos": [
        80,
        600
      ],
      "properties": {
        "path": "Soil_Moisture/SMAP_Auxiliary_Data",
        "dataset_key": "ancillary_mat",
        "notes": "静态辅助库"
      }
    },
    {
      "id": 5,
      "type": "data/source",
      "pos": [
        80,
        760
      ],
      "properties": {
        "path": "Soil_Moisture/SMAP_Auxiliary_Data/NDVI_clim",
        "dataset_key": "ndvi_clim_folder",
        "notes": "NDVI DOY 气候态（SMAP 辅助库 NDVI_clim，与 ndvi_clim_max/min 同源；生态目录 12 月下旬 DOY 全空不可用）"
      }
    },
    {
      "id": 6,
      "type": "data/source",
      "pos": [
        80,
        920
      ],
      "properties": {
        "path": "Meteorological/Weather/GLDAS",
        "dataset_key": "gldas_mat",
        "notes": "本地 GLDAS .mat（若已转好）；在线 nc4 目录由 gldas_download.path 提供，转 mat 后可指向同目录"
      }
    },
    {
      "id": 7,
      "type": "module/omega_avg_daily",
      "pos": [
        560,
        400
      ],
      "properties": {
        "module_name": "omega_avg_daily",
        "task_type": "omega_avg_daily",
        "algorithm_params": {
          "target_year": 2025,
          "tb_source": "SMAP",
          "sm_source": "SMAP",
          "temp_scheme": "DUAL",
          "ndvi_mode": "DOY_CLIM",
          "sf_mode": "STATIC",
          "use_gldas_template": true,
          "dual_tg_mode": "PAPER_CT",
          "ct_smref": 0.3,
          "ct_exp": 0.3,
          "avg_build_start_year": 2025,
          "avg_build_end_year": 2025,
          "freq_ghz": 1.4,
          "lambda_tau": 20.0,
          "pixel_chunk_size": 200000,
          "enable_parallel": true
        }
      }
    },
    {
      "id": 10,
      "type": "output/map_layer",
      "pos": [
        960,
        400
      ],
      "properties": {
        "layer_id": "method-smap-omega-doy-avg",
        "display_name": "SMAP ω 平均反演·双温度（GLDAS 在线）"
      }
    },
    {
      "id": 8,
      "type": "data/time_range",
      "pos": [
        80,
        -40
      ],
      "properties": {
        "start_at": "2025-12-27T00:00:00",
        "end_at": "2025-12-31T00:00:00",
        "resolution_unit": "day",
        "resolution_step": 1,
        "granularity": "day",
        "bind_timeline": true,
        "timezone": "UTC"
      }
    }
  ],
