{
  "_meta": {
    "kind": "system",
    "engine": "python_provider",
    "name": "Stats mean + summary report",
    "description": "data/source → stats/spatial_mean; data/source → viz/statistics_summary → viz/report_export (HTML). Smoke GeoTIFF at {DATA_ROOT}/_runtime/smoke_stub.tif.",
    "author": "system",
    "readonly": true,
    "is_template": true,
    "linked_layer_id": null,
    "tags": ["analysis", "statistics", "report", "stub_v1", "sample", "hidden"],
    "category": "analysis",
    "resource_profile": "standard"
  },
  "workflow_id": "stats_mean_summary_report_basic",
  "name": "Stats mean + summary report",
  "description": "Spatial mean then statistics summary and HTML report",
  "nodes": [
    {
      "id": 1,
      "type": "data/source",
      "pos": [60, 160],
      "properties": {
        "path": "{DATA_ROOT}/_runtime/smoke_stub.tif",
        "dataset_key": "input_path"
      }
    },
    {
      "id": 2,
      "type": "stats/spatial_mean",
      "pos": [340, 160],
      "properties": {
        "statistic": "mean",
        "band": 0
      }
    },
    {
      "id": 3,
      "type": "viz/statistics_summary",
      "pos": [620, 160],
      "properties": {
        "include_mean": true,
        "include_std": true,
        "include_percentiles": true,
        "percentile_list": "25,50,75"
      }
    },
    {
      "id": 4,
      "type": "viz/report_export",
      "pos": [900, 160],
      "properties": {
        "format": "html",
        "template": "default",
        "include_charts": true
      }
    }
  ],
  "links": [
    [1, 1, 2, 2, 2],
    [2, 1, 2, 3, 2],
    [3, 3, 0, 4, 2]
  ]
