{
  "_meta": {
    "kind": "system",
    "engine": "python_provider",
    "name": "GIS raster calc + reclassify",
    "description": "data/source → gis/raster_calculator (A*2) → gis/reclassify. Smoke GeoTIFF at {DATA_ROOT}/_runtime/smoke_stub.tif.",
    "author": "system",
    "readonly": true,
    "is_template": true,
    "linked_layer_id": null,
    "tags": ["analysis", "gis", "raster", "stub_v1", "sample"],
    "category": "analysis",
    "resource_profile": "standard"
  },
  "workflow_id": "gis_raster_calc_reclassify_basic",
  "name": "GIS raster calc + reclassify",
  "description": "Expression then remap table on a smoke raster",
  "nodes": [
    {
      "id": 1,
      "type": "data/source",
      "pos": [60, 160],
      "properties": {
        "path": "{DATA_ROOT}/_runtime/smoke_stub.tif",
        "dataset_key": "input_path"
      }
    },
    {
      "id": 2,
      "type": "gis/raster_calculator",
      "pos": [360, 160],
      "properties": {
        "expression": "A * 2",
        "nodata_handling": "propagate"
      }
    },
    {
      "id": 3,
      "type": "gis/reclassify",
      "pos": [660, 160],
      "properties": {
        "remap_table": "0-10:1,10-100:2,100-1000:3",
        "nodata_value": -9999
      }
    }
  ],
  "links": [
    [1, 1, 2, 2, 1],
    [2, 2, 0, 3, 1]
  ]
}
