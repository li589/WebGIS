{
  "_meta": {
    "kind": "system",
    "engine": "python_provider",
    "name": "FY MWRI 亮温（NSMC 在线拉取）",
    "description": "目的：通过国家卫星气象中心（NSMC）门户在线拉取 FY-3 极轨卫星 MWRI HDF 亮温数据。使用 cma_nsmc 预设 + nsmc 凭证。拉取后解压 HDF 文件并经 fy_preprocess 预处理生成可显示图层。",
    "author": "system",
    "readonly": true,
    "is_template": true,
    "linked_layer_id": "ref-fy-tb-202512-mwri",
    "tags": ["sample", "download"],
    "category": "data_access"
  },
  "workflow_id": "fy_tb_nsmc_online",
  "name": "FY MWRI 亮温（NSMC 在线拉取）",
  "description": "NSMC http_open_data → archive/extract → fy_preprocess → 输出地图图层。",
  "nodes": [
    {
      "id": 1,
      "type": "download/http_open_data",
      "pos": [80, 140],
      "properties": {
        "preset": "cma_nsmc",
        "relative_path": "FY3D/MWRID/{YYYY.MM.DD}/",
        "cred_profile": "nsmc",
        "force_refresh": false
      }
    },
    {
      "id": 2,
      "type": "archive/extract",
      "pos": [400, 140],
      "properties": {
        "member_glob": "*.HDF",
        "recurse_once": true,
        "output_dirname": "fy_extracted"
      }
    },
    {
      "id": 3,
      "type": "download/fy_preprocess",
      "pos": [720, 140],
      "properties": {
        "satellite": "FY3d",
        "orbit_mode": "MWRID",
        "band_ids": [1, 2],
        "outfile_type": "hdf5",
        "spatial_extent": "global"
      }
    },
    {
      "id": 4,
      "type": "output/map_layer",
      "pos": [1040, 140],
      "properties": {
        "layer_id": "ref-fy-tb-202512-mwri",
        "colormap": "viridis",
        "rescale": "200,320"
      }
    }
  ],
  "links": [
    {"0": 1, "1": 1, "2": 0, "3": 2, "4": 0, "5": "value:string"},
    {"0": 2, "1": 2, "2": 0, "3": 3, "4": 0, "5": "value:string"},
    {"0": 3, "1": 3, "2": 0, "3": 4, "4": 0, "5": "value:string"}
  ],
  "extra": {
    "purpose": "online_fy_nsmc_pipeline",
    "scheme": "NSMC_ONLINE_FY",
    "portal": "cma_nsmc",
    "cred_profile": "nsmc",
    "pipeline": "NSMC HTTP download → extract HDF → fy_preprocess → map_layer",
    "prerequisite": "nsmc 凭证（NSMC 门户账号）",
    "notes": "模板种子：relative_path 含 YYYY.MM.DD 占位符，运行前由 resolver 替换。NSMC 门户认证方式可能为 Cookie/Token，在 portal credentials 中配置 token_header。"
  }
}
