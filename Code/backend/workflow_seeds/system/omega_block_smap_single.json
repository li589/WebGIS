      "omega_block",
      "d1"
    ],
    "category": "inversion"
  },
  "workflow_id": "omega_block_smap_single",
  "name": "D1 omega_block（SMAP 单温度）",
  "description": "SMAP 亮温 + 辅助/NDVI → timeseries_bundle → omega_block（daily_omega + h/alpha）。",
  "nodes": [
