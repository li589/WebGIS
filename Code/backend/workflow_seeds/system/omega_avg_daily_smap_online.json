{
  "_meta": {
    "kind": "system",
    "engine": "python_provider",
    "name": "SMAP ω 平均反演（在线）",
    "description": "目的：在线拉取 SMAP L3 SM P（NSIDC 云 CDN，granule URL 经 CMR 解析）.h5 → smap_daily 转逐日 .mat（落盘 DATA_ROOT/Soil_Moisture/SMAP_Origin_Data）→ D2 avg-omega 逐日反演（SMAP_SINGLE + ORIG_TS 单温度方案）→ 发布 SM/VOD/OMEGA 三图层。前置：earthdata 凭证（设置页 earthdata profile）；D1 omega_block 已产出；anc/NDVI 本地就绪。本种子为模板：start_date/end_date 用 YYYYMMDD 占位符，运行前替换。",
    "author": "system",
    "readonly": true,
    "is_template": true,
    "linked_layer_id": "method-smap-omega-doy-avg",
    "tags": [
      "pipeline",
      "omega_avg"
    ],
    "category": "inversion"
  },
  "workflow_id": "omega_avg_daily_smap_online",
  "name": "SMAP ω 平均反演（在线）",
  "description": "nsidc_smap_download（CMR+云 CDN，earthdata 凭证）→ smap_daily（.h5→YYYYMMDD.mat）→ D2 avg-omega 逐日回代（ORIG_TS 单温度）。语义：平均=ω 固定为多年 DOY 气候态均值，逐日仅做轻量 DDCA 回代。",
  "nodes": [
    {
      "id": 1,
      "type": "download/nsidc_smap_download",
      "pos": [
        80,
        140
      ],
      "properties": {
        "start_date": "{YYYYMMDD}",
        "end_date": "{YYYYMMDD}",
        "version": "6",
        "dry_run": false
      }
    },
    {
      "id": 2,
      "type": "module/smap_daily",
      "pos": [
        380,
        140
      ],
      "properties": {
        "output_dir": "{DATA_ROOT}/Soil_Moisture/SMAP_Origin_Data"
      }
    },
    {
      "id": 4,
      "type": "data/source",
      "pos": [
        640,
        40
      ],
      "properties": {
        "path": "Inversion_Results/omega_block",
        "dataset_key": "omega_block_output",
        "notes": "D1 omega_block 输出（avg 气候态构建输入）"
      }
    },
    {
      "id": 5,
      "type": "data/source",
      "pos": [
        640,
        160
      ],
      "properties": {
        "path": "Soil_Moisture/SMAP_Origin_Data",
        "dataset_key": "smap_daily_mat",
        "notes": "逐日 SMAP .mat（smap_daily 落盘同目录，含 TBv/TBh/IA/Ts/vwc/SM）"
      }
    },
    {
      "id": 6,
      "type": "data/source",
      "pos": [
        640,
        280
      ],
      "properties": {
        "path": "Soil_Moisture/SMAP_Auxiliary_Data",
        "dataset_key": "ancillary_mat",
        "notes": "静态辅助库（IGBP_9km_12/Albedo/B/BD/CF/H/SF/VI_v_qa）"
      }
    },
    {
      "id": 7,
      "type": "data/source",
      "pos": [
        640,
        400
      ],
      "properties": {
        "path": "Ecological_Vegetation/NDVI/NDVIday",
        "dataset_key": "ndvi_daily_mat",
        "notes": "逐日 NDVI .mat（ndvi_mode=DAILY_FILE 时使用）"
      }
    },
    {
      "id": 8,
      "type": "data/source",
      "pos": [
        640,
        520
      ],
      "properties": {
        "path": "Soil_Moisture/SMAP_Auxiliary_Data/NDVI_clim",
        "dataset_key": "ndvi_clim_folder",
        "notes": "NDVI DOY 气候态（SMAP 辅助库 NDVI_clim，与 ndvi_clim_max/min 同源；生态目录 12 月下旬 DOY 全空不可用）"
      }
    },
    {
      "id": 3,
      "type": "module/omega_avg_daily",
      "pos": [
        960,
        280
      ],
      "properties": {
        "module_name": "omega_avg_daily",
        "task_type": "omega_avg_daily",
        "algorithm_params": {
          "target_year": 2023,
          "tb_source": "SMAP",
          "sm_source": "SMAP",
          "temp_scheme": "ORIG_TS",
          "ndvi_mode": "DAILY_FILE",
          "sf_mode": "STATIC",
          "avg_build_start_year": 2015,
          "avg_build_end_year": 2025,
          "freq_ghz": 1.4,
          "lambda_tau": 20.0,
          "pixel_chunk_size": 200000,
          "enable_parallel": true
        }
      }
    },
    {
      "id": 9,
      "type": "output/map_layer",
      "pos": [
        1240,
        280
      ],
      "properties": {
        "layer_id": "method-smap-omega-doy-avg",
        "display_name": "SMAP ω 平均反演（在线）"
      }
    }
  ],
