  "extra": {
    "purpose": "online_smap_pipeline",
    "scheme": "SMAP_SINGLE_ORIG_TS_ONLINE_SMAP",
    "portal": "nsidc_data",
    "cred_profile": "earthdata",
    "pipeline": "nsidc_smap_download (CMR+云 CDN) → smap_daily (.h5→YYYYMMDD.mat) → D2 DDCA (ORIG_TS, Ts from SMAP IA) → SM/VOD/OMEGA 三图层",
    "prerequisite": "earthdata 凭证 + D1 omega_block + 本地 anc/NDVI .mat",
    "outputs": [
      "SM",
      "VOD",
      "OMEGA"
    ],
    "notes": "模板种子：start_date/end_date 含 YYYYMMDD 占位符，运行前替换（granule URL 由 nsidc_smap_download 内部经 CMR 动态解析）。smap_daily 将 .h5 转为 YYYYMMDD.mat（含 TBv/TBh/IA/Ts/vwc/SM）落盘 DATA_ROOT/Soil_Moisture/SMAP_Origin_Data，反演经 data/source smap_daily_mat 读取同目录；omega_avg_daily 产出 SM/VOD/OMEGA 三产品经 output/map_layer 发布到 avg 图层。",
    "has_time_range_node": false,
    "has_bbox_node": false,
    "has_output_node": true,
    "group_title": "SMAP ω 反演产物（平均）",
