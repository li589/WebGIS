{
  "_meta": {
    "kind": "system",
    "engine": "python_provider",
    "name": "Analysis: watershed",
    "description": "InfoPanel watershed. Inject DEM raster path and pour points GeoJSON.",
    "author": "system",
    "readonly": true,
    "is_template": true,
    "linked_layer_id": null,
    "tags": [
      "analysis",
      "gis",
      "dem",
      "watershed",
      "ui-panel"
