  "workflow_id": "analysis_watershed",
  "name": "Analysis: watershed",
  "description": "data/source(DEM) + data/source(pour_points) → gis/watershed",
  "nodes": [
    {
      "id": 1,
      "type": "data/source",
      "pos": [
        60,
        100
      ],
      "properties": {
        "path": "{DATA_ROOT}/_runtime/smoke_dem.tif",
        "dataset_key": "input_path"
      }
    },
    {
      "id": 2,
      "type": "data/source",
      "pos": [
        60,
        280
      ],
      "properties": {
        "path": "{DATA_ROOT}/_runtime/smoke_pour_points.geojson",
        "dataset_key": "pour_points_path"
      }
    },
    {
      "id": 3,
      "type": "gis/watershed",
      "pos": [
        400,
        180
      ],
      "properties": {
        "flow_direction": "d8",
        "fill_threshold": 0.01,
        "max_dem_pixels": 4000000
      }
    }
  ],
  "links": [
    [
      1,
      1,
      2,
      3,
      1
    ],
    [
      2,
