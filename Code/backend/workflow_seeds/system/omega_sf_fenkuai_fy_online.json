        "start_date": "{YYYYMMDD}",
        "end_date": "{YYYYMMDD}",
        "local_dir": "{DATA_ROOT}/Soil_Moisture/FY3B/raw",
        "band_ids": "1,2",
        "orbit_mode": "MWRID"
