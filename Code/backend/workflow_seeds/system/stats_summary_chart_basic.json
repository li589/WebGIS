  },
  "workflow_id": "stats_summary_chart_basic",
  "name": "Stats summary + chart",
  "description": "Raster statistics summary then bar chart from table_spec",
  "nodes": [
    {
      "id": 1,
      "type": "data/source",
      "pos": [
        60,
        160
      ],
      "properties": {
        "path": "{DATA_ROOT}/_runtime/smoke_stub.tif",
        "dataset_key": "input_path"
      }
    },
    {
      "id": 2,
      "type": "viz/statistics_summary",
      "pos": [
        360,
        160
      ],
      "properties": {
        "include_mean": true,
