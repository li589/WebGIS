        "include_percentiles": true,
        "percentile_list": "25,50,75"
      }
    },
    {
      "id": 3,
      "type": "viz/chart_generate",
      "pos": [
        660,
        160
      ],
      "properties": {
        "chart_type": "bar",
        "title": "Statistics Summary Chart",
        "x_label": "metric",
        "y_label": "value",
        "write_png": true
      }
    }
  ],
  "links": [
