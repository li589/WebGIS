{
  "_meta": {
    "kind": "system",
    "engine": "python_provider",
    "name": "Stats summary + chart",
    "description": "Smoke GeoTIFF → viz/statistics_summary → viz/chart_generate. Raster at {DATA_ROOT}/_runtime/smoke_stub.tif.",
    "author": "system",
    "readonly": true,
    "is_template": true,
    "linked_layer_id": null,
