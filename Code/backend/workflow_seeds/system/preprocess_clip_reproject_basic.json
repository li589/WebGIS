    "author": "system",
    "readonly": true,
    "is_template": true,
    "linked_layer_id": null,
    "tags": ["analysis", "preprocess", "raster", "stub_v1", "sample", "hidden"],
    "category": "analysis",
    "resource_profile": "heavy"
  },
  "workflow_id": "preprocess_clip_reproject_basic",
  "name": "Preprocess clip + reproject",
  "description": "Clip then reproject a smoke GeoTIFF",
  "nodes": [
    {
      "id": 1,
      "type": "data/source",
      "pos": [60, 160],
      "properties": {
        "path": "{DATA_ROOT}/_runtime/smoke_stub.tif",
        "dataset_key": "input_path",
        "notes": "Generate smoke GeoTIFF before run"
      }
    },
    {
      "id": 2,
      "type": "data/bbox",
      "pos": [60, 320],
      "properties": {
